# ================= BIO CHECK =================

async def check_bio(message: types.Message):
    if message.chat.type not in ["group", "supergroup"]:
        return

    user = await bot.get_chat(message.from_user.id)
    bio = user.bio or ""

    if not bio_pattern.search(bio):
        return

    limit, penalty, apply_to = await get_settings(message.chat.id)

    member = await bot.get_chat_member(message.chat.id, message.from_user.id)

    if apply_to == "members" and member.status != ChatMemberStatus.MEMBER:
        return
    if apply_to == "admins" and member.status not in [ChatMemberStatus.ADMINISTRATOR, ChatMemberStatus.CREATOR]:
        return
    if apply_to == "members_admins" and member.status not in [ChatMemberStatus.MEMBER, ChatMemberStatus.ADMINISTRATOR, ChatMemberStatus.CREATOR]:
        return  # Apply to members, admins, and creators, but not banned/left users

    count = await add_warn(message.chat.id, message.from_user.id)

    warning_msg = await message.reply(
        f"⚠ Warning {count}/{limit} | ID: <code>{message.from_user.id}</code>\n"
        f"Reason: Bio contains link."
    )
    
    # Auto-delete warning message after 1 minute
    import asyncio
    async def delete_warning():
        await asyncio.sleep(60)  # Wait 1 minute
        try:
            await warning_msg.delete()
        except Exception:
            pass  # Message may have been deleted already
    
    asyncio.create_task(delete_warning())

    if count >= limit:
        # Check if the bot has permissions to perform the action
        bot_member = await bot.get_chat_member(message.chat.id, bot.id)
        kb = InlineKeyboardBuilder()
        action_taken = False
        
        if penalty == "mute":
            if bot_member.can_restrict_members:
                await bot.restrict_chat_member(message.chat.id, message.from_user.id, permissions=types.ChatPermissions(can_send_messages=False))
                kb.button(text="✅ Unmute User", callback_data=f"unmute_{message.from_user.id}")
                action_taken = True
        elif penalty == "kick":
            if bot_member.can_restrict_members:
                await bot.ban_chat_member(message.chat.id, message.from_user.id)
                await bot.unban_chat_member(message.chat.id, message.from_user.id)
                kb.button(text="🔄 Re-add User", callback_data=f"readd_{message.from_user.id}")
                action_taken = True
        elif penalty == "ban":
            if bot_member.can_restrict_members:
                await bot.ban_chat_member(message.chat.id, message.from_user.id)
                kb.button(text="🔓 Unban User", callback_data=f"unban_{message.from_user.id}")
                action_taken = True
        
        # Send action message with appropriate button if action was taken
        if action_taken:
            action_msg = await message.reply(
                f"🚨 <b>User {message.from_user.id}</b> has been {penalty}d after {limit} warnings.",
                reply_markup=kb.as_markup()
            )
        else:
            # If bot doesn't have permissions, notify the admins
            action_msg = await message.reply(
                f"🚨 <b>User {message.from_user.id}</b> reached {limit} warnings but bot doesn't have permission to {penalty}.",
            )
        
        # Auto-delete action message after 1 minute
        async def delete_action():
            await asyncio.sleep(60)  # Wait 1 minute
            try:
                await action_msg.delete()
            except Exception:
                pass  # Message may have been deleted already
        
        asyncio.create_task(delete_action())

# Function to check for links in messages and delete them
async def check_message_for_links(message: types.Message):
    if message.chat.type not in ["group", "supergroup"]:
        return

    # Check if message contains text and if it contains a link
    message_text = ""
    if message.text:
        message_text = message.text
    elif message.caption:  # For media messages with captions
        message_text = message.caption
    
    if not message_text:
        return

    # Check if the message contains a link
    if link_pattern.search(message_text):
        # Get settings for the chat
        limit, penalty, apply_to = await get_settings(message.chat.id)
        
        # Check if this applies to the user based on apply_to setting
        member = await bot.get_chat_member(message.chat.id, message.from_user.id)
        
        if apply_to == "members" and member.status != ChatMemberStatus.MEMBER:
            return
        if apply_to == "admins" and member.status not in [ChatMemberStatus.ADMINISTRATOR, ChatMemberStatus.CREATOR]:
            return
        if apply_to == "members_admins" and member.status not in [ChatMemberStatus.MEMBER, ChatMemberStatus.ADMINISTRATOR, ChatMemberStatus.CREATOR]:
            return  # Apply to members, admins, and creators, but not banned/left users

        # Delete the message containing the link
        try:
            await message.delete()
        except Exception as e:
            print(f"Could not delete message: {e}")

        # Add a warning to the user
        count = await add_warn(message.chat.id, message.from_user.id)

        # Send a warning message
        warning_msg = await message.answer(
            f"⚠️ <b>Link Removed!</b> User {message.from_user.full_name} (ID: <code>{message.from_user.id}</code>)\n"
            f"Your message was deleted because it contained a link.\n"
            f"This is warning {count}/{limit}."
        )
        
        # Auto-delete warning message after 30 seconds
        async def delete_warning():
            await asyncio.sleep(30)  # Wait 30 seconds
            try:
                await warning_msg.delete()
            except Exception:
                pass  # Message may have been deleted already
        
        asyncio.create_task(delete_warning())

        # Check if user has reached the warning limit
        if count >= limit:
            # Check if the bot has permissions to perform the action
            bot_member = await bot.get_chat_member(message.chat.id, bot.id)
            kb = InlineKeyboardBuilder()
            action_taken = False
            
            if penalty == "mute":
                if bot_member.can_restrict_members:
                    await bot.restrict_chat_member(message.chat.id, message.from_user.id, permissions=types.ChatPermissions(can_send_messages=False))
                    kb.button(text="✅ Unmute User", callback_data=f"unmute_{message.from_user.id}")
                    action_taken = True
            elif penalty == "kick":
                if bot_member.can_restrict_members:
                    await bot.ban_chat_member(message.chat.id, message.from_user.id)
                    await bot.unban_chat_member(message.chat.id, message.from_user.id)
                    kb.button(text="🔄 Re-add User", callback_data=f"readd_{message.from_user.id}")
                    action_taken = True
            elif penalty == "ban":
                if bot_member.can_restrict_members:
                    await bot.ban_chat_member(message.chat.id, message.from_user.id)
                    kb.button(text="🔓 Unban User", callback_data=f"unban_{message.from_user.id}")
                    action_taken = True
            
            # Send action message with appropriate button if action was taken
            if action_taken:
                action_msg = await message.answer(
                    f"🚨 <b>User {message.from_user.id}</b> has been {penalty}d after reaching {limit} warnings for posting links.",
                    reply_markup=kb.as_markup()
                )
            else:
                # If bot doesn't have permissions, notify the admins
                action_msg = await message.answer(
                    f"🚨 <b>User {message.from_user.id}</b> reached {limit} warnings but bot doesn't have permission to {penalty}.",
                )
            
            # Auto-delete action message after 1 minute
            async def delete_action():
                await asyncio.sleep(60)  # Wait 1 minute
                try:
                    await action_msg.delete()
                except Exception:
                    pass  # Message may have been deleted already
            
            asyncio.create_task(delete_action())

# Trigger on every message
@dp.message()
async def monitor(message: types.Message):
    await check_bio(message)
    await check_message_for_links(message)

# ================= RUN =================

async def main():
    await init_db()
    await dp.start_polling(bot)

if __name__ == "__main__":
    asyncio.run(main())

